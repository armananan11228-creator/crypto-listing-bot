# توکن رباتی که از @BotFather گرفته‌ای
BOT_TOKEN=123456789:AA...your-token...
# آی‌دی عددی چت خودت (از @userinfobot بگیر) یا آی‌دی کانال مثل -1001234567890
CHAT_ID=123456789
# رمز دلخواه؛ در انتهای آدرس وبهوک استفاده می‌شود
WEBHOOK_SECRET=arman-secret-1234
# پورت (اکثر سرویس‌های ابری خودشان ست می‌کنند)
PORT=8080
# جلوگیری از پیام تکراری، به ثانیه
DEDUP_SECONDS=60

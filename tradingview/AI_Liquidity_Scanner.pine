//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  AI Liquidity Scanner  —  Adaptive Ensemble + Liquidity Map
//  Crypto scalping (1m – 15m) | overlay
//
//  موتور تصمیم‌گیری:
//    ۹ عامل مستقل (روند، مومنتوم، حجم، VWAP، تایم‌فریم بالاتر، نقدینگی ...)
//    هر عامل یک امتیاز بین 1- و 1+ می‌دهد.
//    وزن هر عامل به‌صورت خودکار بر اساس عملکرد اخیرش روی همان نماد
//    یاد گرفته و به‌روزرسانی می‌شود (online learning / adaptive weighting).
//
//  ماژول نقدینگی:
//    شناسایی استخرهای نقدینگی (BSL/SSL)، سقف/کف‌های برابر (EQH/EQL)،
//    تشخیص Sweep (شکار نقدینگی) و محاسبه «مغناطیس نقدینگی».
//    به‌علاوه پروفایل حجم (POC / VAH / VAL).
// ═══════════════════════════════════════════════════════════════════════════

indicator("AI Liquidity Scanner [Arena]", shorttitle="AI-LiqScan", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────────── INPUTS ─────────────────────────────────
var string gE = "🧠 موتور تصمیم‌گیری"
sigThreshold = input.float(0.35, "آستانه سیگنال (|score|)", minval = 0.05, maxval = 0.95, step = 0.05, group = gE)
minConf      = input.int(55,   "حداقل اطمینان (%)",        minval = 0,    maxval = 100,          group = gE)
cooldownBars = input.int(5,    "فاصله حداقلی بین سیگنال‌ها (کندل)", minval = 0,                  group = gE)
adaptive     = input.bool(true,"وزن‌دهی خودیادگیر",                                              group = gE)
learnRate    = input.float(0.05,"نرخ یادگیری", minval = 0.005, maxval = 0.5, step = 0.005,       group = gE)
evalBars     = input.int(5,    "افق ارزیابی عملکرد (کندل)", minval = 1, maxval = 50,             group = gE)
htfTF        = input.timeframe("15", "تایم‌فریم بالاتر (بایاس)",                                  group = gE)

var string gW = "⚖️ وزن عوامل"
wTrend = input.float(1.2, "روند EMA",        minval = 0, maxval = 3, step = 0.1, group = gW)
wST    = input.float(1.0, "SuperTrend",      minval = 0, maxval = 3, step = 0.1, group = gW)
wRSI   = input.float(0.8, "RSI",             minval = 0, maxval = 3, step = 0.1, group = gW)
wMACD  = input.float(0.9, "MACD",            minval = 0, maxval = 3, step = 0.1, group = gW)
wStoch = input.float(0.6, "Stochastic",      minval = 0, maxval = 3, step = 0.1, group = gW)
wVol   = input.float(1.0, "فشار حجم (CVD)",  minval = 0, maxval = 3, step = 0.1, group = gW)
wVWAP  = input.float(0.8, "VWAP",            minval = 0, maxval = 3, step = 0.1, group = gW)
wHTF   = input.float(1.1, "تایم‌فریم بالاتر", minval = 0, maxval = 3, step = 0.1, group = gW)
wLiq   = input.float(0.9, "مغناطیس نقدینگی", minval = 0, maxval = 3, step = 0.1, group = gW)

var string gP = "⚙️ پارامترها"
emaFastLen = input.int(9,  "EMA سریع",  minval = 2, group = gP)
emaSlowLen = input.int(21, "EMA کند",   minval = 3, group = gP)
rsiLen     = input.int(14, "RSI",       minval = 2, group = gP)
atrLen     = input.int(14, "ATR",       minval = 2, group = gP)
stFactor   = input.float(2.0, "SuperTrend factor", minval = 0.5, step = 0.1, group = gP)
stAtr      = input.int(10, "SuperTrend ATR",       minval = 2,               group = gP)

var string gL = "💧 نقدینگی"
showLiq    = input.bool(true, "نمایش استخرهای نقدینگی",                        group = gL)
pivLen     = input.int(8,   "حساسیت پیوت", minval = 2, maxval = 50,            group = gL)
maxPools   = input.int(14,  "حداکثر سطوح هر سمت", minval = 2, maxval = 40,     group = gL)
eqTol      = input.float(0.15, "تلورانس سقف/کف برابر (× ATR)", minval = 0.01, step = 0.01, group = gL)
showSwept  = input.bool(true, "نمایش Sweep ها",                                group = gL)
colBSL     = input.color(color.new(#ef5350, 20), "نقدینگی بالا (BSL)",         group = gL)
colSSL     = input.color(color.new(#26a69a, 20), "نقدینگی پایین (SSL)",        group = gL)

var string gV = "📊 پروفایل حجم"
showVP   = input.bool(true, "نمایش POC / VAH / VAL",                  group = gV)
vpLook   = input.int(200, "دوره بررسی", minval = 30, maxval = 1000,   group = gV)
vpBins   = input.int(40,  "تعداد ردیف", minval = 10, maxval = 120,    group = gV)

var string gD = "🖥️ نمایش"
showDash  = input.bool(true,  "داشبورد",                                 group = gD)
dashPos   = input.string("بالا-راست", "محل داشبورد", options = ["بالا-راست", "بالا-چپ", "پایین-راست", "پایین-چپ", "وسط-راست"], group = gD)
showSig   = input.bool(true,  "فلش سیگنال",                              group = gD)
showLvls  = input.bool(true,  "نمایش خطوط SL / TP سیگنال",               group = gD)
colorBars = input.bool(true,  "رنگ‌آمیزی کندل‌ها بر اساس امتیاز",          group = gD)
slAtrMult = input.float(1.2, "SL (× ATR)", minval = 0.2, step = 0.1,     group = gD)
tp1RR     = input.float(1.0, "TP1 (R)",    minval = 0.2, step = 0.1,     group = gD)
tp2RR     = input.float(2.0, "TP2 (R)",    minval = 0.2, step = 0.1,     group = gD)

// ───────────────────────────────── HELPERS ────────────────────────────────
clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))

// ──────────────────────────── BASE CALCULATIONS ───────────────────────────
atr      = ta.atr(atrLen)
atrSafe  = math.max(atr, syminfo.mintick)
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
ema200   = ta.ema(close, 200)
rsi      = ta.rsi(close, rsiLen)
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
stochK   = ta.sma(ta.stoch(close, high, low, 14), 3)
[stLine, stDir] = ta.supertrend(stFactor, stAtr)
[diPlus, diMinus, adxV] = ta.dmi(14, 14)
vwapV    = ta.vwap(hlc3)
volAvg   = ta.sma(volume, 20)
volRatio = volume / math.max(volAvg, 1e-10)

// فشار حجم (تقریب Cumulative Volume Delta)
barRange = math.max(high - low, syminfo.mintick)
delta    = ((close - open) / barRange) * volume
cvd      = ta.cum(delta)
cvdSlope = ta.linreg(cvd, 20, 0) - ta.linreg(cvd, 20, 1)
cvdNorm  = cvdSlope / math.max(ta.stdev(cvd - cvd[1], 50), 1e-10)

// تایم‌فریم بالاتر
htfEmaF  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 21),   lookahead = barmerge.lookahead_off)
htfEmaS  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 50),   lookahead = barmerge.lookahead_off)
htfRsi   = request.security(syminfo.tickerid, htfTF, ta.rsi(close, 14),   lookahead = barmerge.lookahead_off)

// ══════════════════════════ LIQUIDITY ENGINE ══════════════════════════════
type Liq
    float price
    int   barIdx
    bool  isHigh
    bool  swept
    bool  strong
    line  ln
    label lb

var array<Liq> pools = array.new<Liq>()

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)

addPool(float p, bool isHigh) =>
    // آیا با سطح موجود «برابر» است؟ (EQH / EQL)
    bool merged = false
    if array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Liq q = array.get(pools, i)
            if not q.swept and q.isHigh == isHigh and math.abs(q.price - p) <= eqTol * atrSafe
                q.strong := true
                q.price  := math.avg(q.price, p)
                if not na(q.ln)
                    line.set_y1(q.ln, q.price)
                    line.set_y2(q.ln, q.price)
                    line.set_width(q.ln, 2)
                merged := true
                break
    if not merged
        color col = isHigh ? colBSL : colSSL
        line  ln  = na
        if showLiq
            ln := line.new(bar_index - pivLen, p, bar_index, p, color = col, width = 1, style = line.style_solid, extend = extend.none)
        array.push(pools, Liq.new(price = p, barIdx = bar_index - pivLen, isHigh = isHigh, swept = false, strong = false, ln = ln, lb = na))
    merged

if not na(ph)
    addPool(ph, true)
if not na(pl)
    addPool(pl, false)

// پاک‌سازی سطوح مازاد
cleanup(bool isHigh) =>
    int cnt = 0
    if array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Liq q = array.get(pools, i)
            if q.isHigh == isHigh and not q.swept
                cnt += 1
        if cnt > maxPools
            int toDrop = cnt - maxPools
            for i = 0 to array.size(pools) - 1
                if toDrop <= 0
                    break
                if i < array.size(pools)
                    Liq q = array.get(pools, i)
                    if q.isHigh == isHigh and not q.swept
                        line.delete(q.ln)
                        label.delete(q.lb)
                        array.remove(pools, i)
                        toDrop -= 1
    cnt

cleanup(true)
cleanup(false)

// به‌روزرسانی، تشخیص Sweep و محاسبه مغناطیس نقدینگی
var bool sweepUp   = false
var bool sweepDown = false
sweepUp   := false
sweepDown := false
float liqAbove = 0.0
float liqBelow = 0.0
float nearAbove = na
float nearBelow = na

if array.size(pools) > 0
    for i = array.size(pools) - 1 to 0
        if i < array.size(pools)
            Liq q = array.get(pools, i)
            if q.swept and bar_index - q.barIdx > 400
                line.delete(q.ln)
                label.delete(q.lb)
                array.remove(pools, i)
            else if not q.swept
                bool hit = q.isHigh ? high > q.price : low < q.price
                if hit
                    q.swept := true
                    if not na(q.ln)
                        line.set_x2(q.ln, bar_index)
                        line.set_style(q.ln, line.style_dotted)
                        line.set_color(q.ln, color.new(color.gray, 55))
                    if showSwept and showLiq
                        q.lb := label.new(bar_index, q.price, q.isHigh ? "✖ BSL sweep" : "✖ SSL sweep",
                             style = q.isHigh ? label.style_label_down : label.style_label_up,
                             color = color.new(color.gray, 25), textcolor = color.white, size = size.tiny)
                    if q.isHigh
                        sweepUp := true
                    else
                        sweepDown := true
                else
                    if not na(q.ln)
                        line.set_x2(q.ln, bar_index + 3)
                        line.set_width(q.ln, q.strong ? 2 : 1)
                    float dist = math.abs(q.price - close) / atrSafe
                    float w    = (q.strong ? 2.0 : 1.0) / (1.0 + dist)
                    if q.price > close
                        liqAbove += w
                        nearAbove := na(nearAbove) ? q.price : math.min(nearAbove, q.price)
                    else
                        liqBelow += w
                        nearBelow := na(nearBelow) ? q.price : math.max(nearBelow, q.price)

liqMagnet = (liqAbove + liqBelow) > 0 ? (liqAbove - liqBelow) / (liqAbove + liqBelow) : 0.0

// ═════════════════════════ VOLUME PROFILE (POC/VA) ════════════════════════
var line pocLn = na
var line vahLn = na
var line valLn = na
var float poc = na
var float vah = na
var float val = na

if showVP and barstate.islast
    int   look = int(math.max(10, math.min(vpLook, bar_index)))
    float hh = ta.highest(high, look)
    float ll = ta.lowest(low, look)
    float step = (hh - ll) / vpBins
    if step > 0
        array<float> binVol = array.new_float(vpBins, 0.0)
        for b = 0 to look - 1
            float c = (nz(high[b]) + nz(low[b])) / 2.0
            if c > 0
                int idx = int(math.min(vpBins - 1, math.max(0, int((c - ll) / step))))
                array.set(binVol, idx, array.get(binVol, idx) + nz(volume[b]))
        int   pocIdx = array.indexof(binVol, array.max(binVol))
        float total  = array.sum(binVol)
        poc := ll + (pocIdx + 0.5) * step
        // محدوده ارزش ۷۰٪
        float acc = array.get(binVol, pocIdx)
        int lo = pocIdx
        int hi = pocIdx
        while acc < total * 0.7 and (lo > 0 or hi < vpBins - 1)
            float dn = lo > 0 ? array.get(binVol, lo - 1) : -1.0
            float up = hi < vpBins - 1 ? array.get(binVol, hi + 1) : -1.0
            if up >= dn
                hi += 1
                acc += math.max(up, 0)
            else
                lo -= 1
                acc += math.max(dn, 0)
        vah := ll + (hi + 0.5) * step
        val := ll + (lo + 0.5) * step
        line.delete(pocLn)
        line.delete(vahLn)
        line.delete(valLn)
        pocLn := line.new(bar_index - look, poc, bar_index + 6, poc, color = color.new(color.orange, 0),  width = 2)
        vahLn := line.new(bar_index - look, vah, bar_index + 6, vah, color = color.new(color.orange, 60), style = line.style_dashed)
        valLn := line.new(bar_index - look, val, bar_index + 6, val, color = color.new(color.orange, 60), style = line.style_dashed)

// ═══════════════════════ FACTOR SCORES  (−1 … +1) ═════════════════════════
sTrend = clamp(((emaFast - emaSlow) / atrSafe) * 1.5, -1, 1) * 0.6 + clamp((close - ema200) / (atrSafe * 4), -1, 1) * 0.4
sST    = stDir < 0 ? 1.0 : -1.0
sRSI   = clamp((rsi - 50) / 25, -1, 1)
sMACD  = clamp((macdH / atrSafe) * 4, -1, 1)
sStoch = clamp((stochK - 50) / 40, -1, 1)
sVol   = clamp(cvdNorm / 2.0, -1, 1)
sVWAP  = clamp((close - vwapV) / (atrSafe * 2), -1, 1)
sHTF   = clamp(((htfEmaF - htfEmaS) / atrSafe) * 1.2, -1, 1) * 0.6 + clamp((htfRsi - 50) / 25, -1, 1) * 0.4
sLiq   = clamp(liqMagnet * 1.2, -1, 1)

// بونوس شکار نقدینگی (Liquidity sweep = احتمال برگشت)
sweepBonus = sweepDown and close > open ? 0.25 : sweepUp and close < open ? -0.25 : 0.0

array<float> fScore = array.from(sTrend, sST, sRSI, sMACD, sStoch, sVol, sVWAP, sHTF, sLiq)
array<float> fBaseW = array.from(wTrend, wST, wRSI, wMACD, wStoch, wVol, wVWAP, wHTF, wLiq)
nFac = array.size(fScore)

// ───────────────── ADAPTIVE WEIGHTS (online performance learning) ─────────
var array<float> perf = array.new_float(9, 0.0)
var array<float> histQ = array.new_float()

for i = 0 to nFac - 1
    array.push(histQ, array.get(fScore, i))

if array.size(histQ) > nFac * evalBars
    float fwdRet = (close - close[evalBars]) / math.max(nz(atr[evalBars], atrSafe), syminfo.mintick)
    float retN   = clamp(fwdRet / 2.0, -1, 1)
    for i = 0 to nFac - 1
        float sOld = array.get(histQ, 0)
        array.remove(histQ, 0)
        float hit = clamp(sOld * retN * 2.0, -1, 1)
        array.set(perf, i, array.get(perf, i) * (1 - learnRate) + learnRate * hit)

getMult(int i) => adaptive ? clamp(1.0 + array.get(perf, i) * 2.0, 0.25, 2.0) : 1.0

float wSum = 0.0
float sSum = 0.0
int   agree = 0
for i = 0 to nFac - 1
    float w = array.get(fBaseW, i) * getMult(i)
    wSum += w
    sSum += w * array.get(fScore, i)

score = wSum > 0 ? clamp(sSum / wSum + sweepBonus, -1, 1) : 0.0

for i = 0 to nFac - 1
    if math.sign(array.get(fScore, i)) == math.sign(score) and array.get(fScore, i) != 0
        agree += 1
agreePct = nFac > 0 ? agree / float(nFac) : 0.0

// ───────────────────────────── CONFIDENCE ─────────────────────────────────
adxF   = clamp(adxV / 30.0, 0, 1.2)
volF   = clamp(volRatio, 0.4, 2.0)
conf   = clamp(math.abs(score) * 100 * (0.55 + 0.45 * adxF) * (0.85 + 0.15 * volF) * (0.6 + 0.6 * agreePct), 0, 99)

regime = adxV >= 25 ? "روندی 🚀" : adxV >= 18 ? "در حال شکل‌گیری" : "رِنج 🌀"
atrPct = atr / close * 100

// ───────────────────────────── SIGNAL LOGIC ───────────────────────────────
var int lastSigBar = -1000
canFire  = bar_index - lastSigBar > cooldownBars
rawLong  = ta.crossover(score,  sigThreshold)
rawShort = ta.crossunder(score, -sigThreshold)
longSig  = rawLong  and conf >= minConf and canFire and barstate.isconfirmed
shortSig = rawShort and conf >= minConf and canFire and barstate.isconfirmed

var float entryP = na
var float slP    = na
var float tp1P   = na
var float tp2P   = na
var int   dir    = 0

if longSig or shortSig
    lastSigBar := bar_index
    entryP := close
    dir    := longSig ? 1 : -1
    float risk = slAtrMult * atr
    slP  := longSig ? close - risk : close + risk
    tp1P := longSig ? close + risk * tp1RR : close - risk * tp1RR
    tp2P := longSig ? close + risk * tp2RR : close - risk * tp2RR

plotshape(showSig and longSig,  title = "BUY",  style = shape.labelup,   location = location.belowbar,
     color = color.new(#26a69a, 0), textcolor = color.white, text = "BUY",  size = size.small)
plotshape(showSig and shortSig, title = "SELL", style = shape.labeldown, location = location.abovebar,
     color = color.new(#ef5350, 0), textcolor = color.white, text = "SELL", size = size.small)

// خطوط SL / TP آخرین سیگنال
var line enLn = na
var line slLn = na
var line t1Ln = na
var line t2Ln = na
if showLvls and (longSig or shortSig)
    line.delete(enLn)
    line.delete(slLn)
    line.delete(t1Ln)
    line.delete(t2Ln)
    enLn := line.new(bar_index, entryP, bar_index + 25, entryP, color = color.new(color.blue, 20),  style = line.style_dashed)
    slLn := line.new(bar_index, slP,    bar_index + 25, slP,    color = color.new(#ef5350, 10),     width = 2)
    t1Ln := line.new(bar_index, tp1P,   bar_index + 25, tp1P,   color = color.new(#26a69a, 40),     style = line.style_dashed)
    t2Ln := line.new(bar_index, tp2P,   bar_index + 25, tp2P,   color = color.new(#26a69a, 10),     width = 2)

// ───────────────────────────── VISUALS ────────────────────────────────────
pFast = plot(emaFast, "EMA سریع", color = color.new(color.aqua, 55), linewidth = 1)
pSlow = plot(emaSlow, "EMA کند",  color = color.new(color.orange, 55), linewidth = 1)
fill(pFast, pSlow, color = emaFast > emaSlow ? color.new(#26a69a, 88) : color.new(#ef5350, 88))
plot(vwapV, "VWAP", color = color.new(color.purple, 35), linewidth = 1)

scoreCol = score > 0 ? color.new(#26a69a, int(math.max(0, 85 - math.abs(score) * 85)))
                     : color.new(#ef5350, int(math.max(0, 85 - math.abs(score) * 85)))
barcolor(colorBars ? scoreCol : na)

// ───────────────────────────── DASHBOARD ──────────────────────────────────
f_pos() =>
    switch dashPos
        "بالا-راست"   => position.top_right
        "بالا-چپ"     => position.top_left
        "پایین-راست"  => position.bottom_right
        "پایین-چپ"    => position.bottom_left
        => position.middle_right

scoreBar(float s) =>
    int filled = int(math.max(1, math.min(5, math.round(math.abs(s) * 5))))
    str.repeat(s >= 0 ? "▰" : "▱", filled) + str.repeat("·", 5 - filled)

var table dash = table.new(f_pos(), 3, 17, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 50))

rowFactor(int r, string name, float s, int idx) =>
    col = s > 0.1 ? #26a69a : s < -0.1 ? #ef5350 : color.gray
    table.cell(dash, 0, r, name, text_size = size.tiny, text_color = color.new(color.white, 25), text_halign = text.align_left)
    table.cell(dash, 1, r, scoreBar(s), text_size = size.tiny, text_color = col)
    table.cell(dash, 2, r, (adaptive ? "×" + str.tostring(getMult(idx), "#.0#") : str.tostring(s, "#.00")),
         text_size = size.tiny, text_color = color.new(color.silver, 20))

if showDash and barstate.islast
    bias    = score > sigThreshold ? "صعودی" : score < -sigThreshold ? "نزولی" : "خنثی"
    biasCol = score > sigThreshold ? #26a69a : score < -sigThreshold ? #ef5350 : color.gray
    table.cell(dash, 0, 0, "🧠 AI Liquidity Scanner", text_size = size.small, text_color = color.white, bgcolor = color.new(#2962ff, 20))
    table.merge_cells(dash, 0, 0, 2, 0)

    table.cell(dash, 0, 1, "جهت", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 1, bias, text_size = size.small, text_color = color.white, bgcolor = color.new(biasCol, 30))
    table.cell(dash, 2, 1, str.tostring(score, "#.00"), text_size = size.tiny, text_color = color.white)

    table.cell(dash, 0, 2, "اطمینان", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 2, str.tostring(conf, "#") + "%", text_size = size.small, text_color = color.white,
         bgcolor = color.new(conf >= 70 ? #26a69a : conf >= 50 ? color.orange : color.gray, 35))
    table.cell(dash, 2, 2, str.tostring(math.round(agreePct * 100)) + "% هم‌جهت", text_size = size.tiny, text_color = color.silver)

    table.cell(dash, 0, 3, "رژیم بازار", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 3, regime, text_size = size.tiny, text_color = color.white)
    table.cell(dash, 2, 3, "ADX " + str.tostring(adxV, "#"), text_size = size.tiny, text_color = color.silver)

    table.cell(dash, 0, 4, "نوسان (ATR%)", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 4, str.tostring(atrPct, "#.##") + "%", text_size = size.tiny, text_color = color.white)
    table.cell(dash, 2, 4, "حجم ×" + str.tostring(volRatio, "#.0"), text_size = size.tiny,
         text_color = volRatio > 1.5 ? #26a69a : color.silver)

    rowFactor(5,  "روند EMA",       sTrend, 0)
    rowFactor(6,  "SuperTrend",     sST,    1)
    rowFactor(7,  "RSI",            sRSI,   2)
    rowFactor(8,  "MACD",           sMACD,  3)
    rowFactor(9,  "Stochastic",     sStoch, 4)
    rowFactor(10, "فشار حجم",        sVol,   5)
    rowFactor(11, "VWAP",           sVWAP,  6)
    rowFactor(12, "HTF " + htfTF,   sHTF,   7)
    rowFactor(13, "مغناطیس نقدینگی", sLiq,   8)

    table.cell(dash, 0, 14, "💧 نقدینگی بالا", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 14, na(nearAbove) ? "—" : str.tostring(nearAbove, format.mintick), text_size = size.tiny, text_color = #ef5350)
    table.cell(dash, 2, 14, str.tostring(liqAbove, "#.0"), text_size = size.tiny, text_color = color.silver)

    table.cell(dash, 0, 15, "💧 نقدینگی پایین", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 15, na(nearBelow) ? "—" : str.tostring(nearBelow, format.mintick), text_size = size.tiny, text_color = #26a69a)
    table.cell(dash, 2, 15, str.tostring(liqBelow, "#.0"), text_size = size.tiny, text_color = color.silver)

    plan = dir == 0 or na(entryP) ? "بدون معامله فعال" :
         (dir == 1 ? "LONG " : "SHORT ") + str.tostring(entryP, format.mintick) +
         "  SL " + str.tostring(slP, format.mintick) + "  TP " + str.tostring(tp2P, format.mintick)
    table.cell(dash, 0, 16, plan, text_size = size.tiny, text_color = color.white,
         bgcolor = color.new(dir == 1 ? #26a69a : dir == -1 ? #ef5350 : color.gray, 55))
    table.merge_cells(dash, 0, 16, 2, 16)

// ───────────────────────────── ALERTS ─────────────────────────────────────
alertcondition(longSig,   "🟢 سیگنال خرید",  "AI-LiqScan BUY")
alertcondition(shortSig,  "🔴 سیگنال فروش",  "AI-LiqScan SELL")
alertcondition(sweepUp,   "✖ شکار نقدینگی بالا", "BSL swept")
alertcondition(sweepDown, "✖ شکار نقدینگی پایین","SSL swept")

if longSig or shortSig
    alert((longSig ? "🟢 BUY " : "🔴 SELL ") + syminfo.ticker + " | " + timeframe.period +
         "\nقیمت: "     + str.tostring(close, format.mintick) +
         "\nامتیاز: "    + str.tostring(score, "#.00") +
         " | اطمینان: " + str.tostring(conf, "#") + "%" +
         "\nرژیم: "      + regime +
         "\nSL: "  + str.tostring(slP,  format.mintick) +
         " | TP1: " + str.tostring(tp1P, format.mintick) +
         " | TP2: " + str.tostring(tp2P, format.mintick), alert.freq_once_per_bar_close)

//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  AI Liquidity Scanner  v3  —  Advanced Signals + 15-Symbol Scanner
//  Crypto scalping (1m – 15m) | overlay
//
//  ✍️  طراحی و توسعه توسط آرمان ناصری
//
//  v3:
//    • سیگنال‌دهی پیشرفته: دو موتور (روندی + بازگشتی روی شکار نقدینگی)
//      با درجه‌بندی کیفیت A+ / A / B و فیلترهای چندلایه
//    • مدیریت زنده معامله: TP1 / TP2 / SL، انتقال به نقطه سربه‌سر، سود لحظه‌ای (R)
//    • آمار عملکرد: تعداد برد/باخت، وین‌ریت، مجموع R
//    • اسکنر ۱۵ ارزی
// ═══════════════════════════════════════════════════════════════════════════

indicator("AI Liquidity Scanner [Arman Naseri]", shorttitle="AI-LiqScan v3", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────────── INPUTS ─────────────────────────────────
var string gE = "🧠 موتور تصمیم‌گیری"
sigThreshold = input.float(0.35, "آستانه سیگنال (|score|)", minval = 0.05, maxval = 0.95, step = 0.05, group = gE)
minConf      = input.int(55,   "حداقل اطمینان (%)",        minval = 0,    maxval = 100,          group = gE)
cooldownBars = input.int(5,    "فاصله حداقلی بین سیگنال‌ها (کندل)", minval = 0,                  group = gE)
adaptive     = input.bool(true,"وزن‌دهی خودیادگیر",                                              group = gE)
learnRate    = input.float(0.05,"نرخ یادگیری", minval = 0.005, maxval = 0.5, step = 0.005,       group = gE)
evalBars     = input.int(5,    "افق ارزیابی عملکرد (کندل)", minval = 1, maxval = 50,             group = gE)
htfTF        = input.timeframe("15", "تایم‌فریم بالاتر (بایاس)",                                  group = gE)

var string gSg = "🎯 سیگنال‌دهی پیشرفته"
sigMode      = input.string("هوشمند (روندی + بازگشتی)", "حالت سیگنال",
     options = ["هوشمند (روندی + بازگشتی)", "فقط روندی", "فقط بازگشتی"], group = gSg)
minGrade     = input.string("B", "حداقل کیفیت سیگنال", options = ["A+", "A", "B"], group = gSg)
useHTF       = input.bool(true,  "فیلتر هم‌جهتی با تایم‌فریم بالاتر",           group = gSg)
useVolFilter = input.bool(true,  "فیلتر حجم",                                 group = gSg)
minVolRatio  = input.float(1.0,  "حداقل نسبت حجم", minval = 0.1, step = 0.1,  group = gSg)
useAdx       = input.bool(true,  "فیلتر رژیم (ADX) برای سیگنال روندی",         group = gSg)
adxMin       = input.int(18,     "حداقل ADX", minval = 5, maxval = 50,        group = gSg)
maxExt       = input.float(3.0,  "حداکثر کشیدگی از EMA (× ATR)", minval = 0.5, step = 0.5, group = gSg)
useBE        = input.bool(true,  "انتقال SL به نقطه ورود بعد از TP1",          group = gSg)
showStats    = input.bool(true,  "آمار عملکرد در داشبورد",                     group = gSg)

var string gW = "⚖️ وزن عوامل"
wTrend = input.float(1.2, "روند EMA",        minval = 0, maxval = 3, step = 0.1, group = gW)
wST    = input.float(1.0, "SuperTrend",      minval = 0, maxval = 3, step = 0.1, group = gW)
wRSI   = input.float(0.8, "RSI",             minval = 0, maxval = 3, step = 0.1, group = gW)
wMACD  = input.float(0.9, "MACD",            minval = 0, maxval = 3, step = 0.1, group = gW)
wStoch = input.float(0.6, "Stochastic",      minval = 0, maxval = 3, step = 0.1, group = gW)
wVol   = input.float(1.0, "فشار حجم (CVD)",  minval = 0, maxval = 3, step = 0.1, group = gW)
wVWAP  = input.float(0.8, "VWAP",            minval = 0, maxval = 3, step = 0.1, group = gW)
wHTF   = input.float(1.1, "تایم‌فریم بالاتر", minval = 0, maxval = 3, step = 0.1, group = gW)
wLiq   = input.float(0.9, "مغناطیس نقدینگی", minval = 0, maxval = 3, step = 0.1, group = gW)

var string gP = "⚙️ پارامترها"
emaFastLen = input.int(9,  "EMA سریع",  minval = 2, group = gP)
emaSlowLen = input.int(21, "EMA کند",   minval = 3, group = gP)
rsiLen     = input.int(14, "RSI",       minval = 2, group = gP)
atrLen     = input.int(14, "ATR",       minval = 2, group = gP)
stFactor   = input.float(2.0, "SuperTrend factor", minval = 0.5, step = 0.1, group = gP)
stAtr      = input.int(10, "SuperTrend ATR",       minval = 2,               group = gP)

var string gL = "💧 نقدینگی (روی چارت)"
showLiq    = input.bool(true, "نمایش سطوح نقدینگی",                            group = gL)
hideSwept  = input.bool(true, "حذف سطح بعد از مصرف شدن",                       group = gL)
onlyStrong = input.bool(false,"فقط نقدینگی سنگین (EQH/EQL)",                   group = gL)
pivLen     = input.int(10,  "حساسیت پیوت", minval = 2, maxval = 50,            group = gL)
maxPools   = input.int(6,   "حداکثر سطوح هر سمت", minval = 1, maxval = 40,     group = gL)
eqTol      = input.float(0.15, "تلورانس سقف/کف برابر (× ATR)", minval = 0.01, step = 0.01, group = gL)
showSwept  = input.bool(false,"برچسب Sweep",                                   group = gL)
colBSL     = input.color(color.new(#ef5350, 25), "نقدینگی بالا (BSL)",         group = gL)
colSSL     = input.color(color.new(#26a69a, 25), "نقدینگی پایین (SSL)",        group = gL)

var string gT = "📐 نمایش معامله روی چارت"
showSig   = input.bool(true,  "برچسب بزرگ سیگنال",                      group = gT)
showArrow = input.bool(true,  "فلش خرید/فروش",                          group = gT)
showLvls  = input.bool(true,  "خطوط Entry / SL / TP",                   group = gT)
showZones = input.bool(true,  "ناحیه ریسک و ریوارد (باکس رنگی)",         group = gT)
showRR    = input.bool(true,  "برچسب ریسک به ریوارد",                    group = gT)
showExit  = input.bool(true,  "برچسب TP/SL خورده",                       group = gT)
slAtrMult = input.float(1.2, "SL (× ATR)", minval = 0.2, step = 0.1,    group = gT)
tp1RR     = input.float(1.0, "TP1 (R)",    minval = 0.2, step = 0.1,    group = gT)
tp2RR     = input.float(2.0, "TP2 (R)",    minval = 0.2, step = 0.1,    group = gT)

var string gD = "🖥️ داشبورد"
showDash  = input.bool(true, "نمایش داشبورد",                            group = gD)
panelMode = input.string("برچسب روی چارت (موبایل)", "نوع نمایش پنل",
     options = ["برچسب روی چارت (موبایل)", "جدول (دسکتاپ)", "هر دو"], group = gD)
dashFull  = input.bool(false,"حالت کامل (نمایش تمام عوامل)",             group = gD)
dashPos   = input.string("بالا-راست", "محل داشبورد", options = ["بالا-راست", "بالا-چپ", "پایین-چپ", "وسط-راست"], group = gD)
sigText   = input.string("طراحی و توسعه توسط آرمان ناصری", "امضا", group = gD)

var string gS = "🔎 اسکنر ۱۵ ارزی"
showScan  = input.bool(true, "نمایش اسکنر",                                  group = gS)
scanPos   = input.string("پایین-راست", "محل اسکنر", options = ["پایین-راست", "پایین-چپ", "وسط-راست", "بالا-چپ"], group = gS)
scanTF    = input.timeframe("", "تایم‌فریم اسکن (خالی = چارت)",               group = gS)
scanReady = input.bool(false,"فقط ارزهای آماده",                              group = gS)
scanBars  = input.int(600, "عمق محاسبه اسکنر (کندل)", minval = 200, maxval = 5000, step = 100, group = gS)
exchSel   = input.string("BINANCE", "صرافی (برای همه ارزها)",
     options = ["AUTO (همان صرافی چارت)", "BINANCE", "BINANCE فیوچرز", "BYBIT", "BYBIT فیوچرز",
                "OKX", "MEXC", "KUCOIN", "GATEIO", "COINBASE", "بدون پیشوند"], group = gS,
     tooltip = "اگر خطای «نماد پشتیبانی نمی‌شود» گرفتی، صرافی را عوض کن یا AUTO بگذار")
// نام ارزها بدون پیشوند صرافی وارد شود؛ مثال: BTCUSDT
c1  = input.string("BTCUSDT", "ارز ۱", group = gS)
c2  = input.string("ETHUSDT", "ارز ۲", group = gS)
c3  = input.string("SOLUSDT", "ارز ۳", group = gS)
c4  = input.string("BNBUSDT", "ارز ۴", group = gS)
c5  = input.string("XRPUSDT", "ارز ۵", group = gS)
c6  = input.string("DOGEUSDT", "ارز ۶", group = gS)
c7  = input.string("ADAUSDT", "ارز ۷", group = gS)
c8  = input.string("AVAXUSDT", "ارز ۸", group = gS)
c9  = input.string("LINKUSDT", "ارز ۹", group = gS)
c10 = input.string("TONUSDT", "ارز ۱۰", group = gS)
c11 = input.string("TRXUSDT", "ارز ۱۱", group = gS)
c12 = input.string("DOTUSDT", "ارز ۱۲", group = gS)
c13 = input.string("NEARUSDT", "ارز ۱۳", group = gS)
c14 = input.string("SUIUSDT", "ارز ۱۴", group = gS)
c15 = input.string("LTCUSDT", "ارز ۱۵", group = gS)

pfx = switch exchSel
    "AUTO (همان صرافی چارت)" => syminfo.prefix + ":"
    "BINANCE" => "BINANCE:"
    "BINANCE فیوچرز" => "BINANCE:"
    "BYBIT" => "BYBIT:"
    "BYBIT فیوچرز" => "BYBIT:"
    "OKX" => "OKX:"
    "MEXC" => "MEXC:"
    "KUCOIN" => "KUCOIN:"
    "GATEIO" => "GATEIO:"
    "COINBASE" => "COINBASE:"
    => ""
sfx = exchSel == "BINANCE فیوچرز" or exchSel == "BYBIT فیوچرز" ? ".P" : ""
sym1  = str.length(c1) == 0 ? syminfo.tickerid : pfx + str.upper(c1) + sfx
sym2  = str.length(c2) == 0 ? syminfo.tickerid : pfx + str.upper(c2) + sfx
sym3  = str.length(c3) == 0 ? syminfo.tickerid : pfx + str.upper(c3) + sfx
sym4  = str.length(c4) == 0 ? syminfo.tickerid : pfx + str.upper(c4) + sfx
sym5  = str.length(c5) == 0 ? syminfo.tickerid : pfx + str.upper(c5) + sfx
sym6  = str.length(c6) == 0 ? syminfo.tickerid : pfx + str.upper(c6) + sfx
sym7  = str.length(c7) == 0 ? syminfo.tickerid : pfx + str.upper(c7) + sfx
sym8  = str.length(c8) == 0 ? syminfo.tickerid : pfx + str.upper(c8) + sfx
sym9  = str.length(c9) == 0 ? syminfo.tickerid : pfx + str.upper(c9) + sfx
sym10 = str.length(c10) == 0 ? syminfo.tickerid : pfx + str.upper(c10) + sfx
sym11 = str.length(c11) == 0 ? syminfo.tickerid : pfx + str.upper(c11) + sfx
sym12 = str.length(c12) == 0 ? syminfo.tickerid : pfx + str.upper(c12) + sfx
sym13 = str.length(c13) == 0 ? syminfo.tickerid : pfx + str.upper(c13) + sfx
sym14 = str.length(c14) == 0 ? syminfo.tickerid : pfx + str.upper(c14) + sfx
sym15 = str.length(c15) == 0 ? syminfo.tickerid : pfx + str.upper(c15) + sfx

var string gX = "🎨 نمایش اضافی (پیش‌فرض خاموش)"
showEma   = input.bool(false, "خطوط EMA",                       group = gX)
showVwap  = input.bool(false, "خط VWAP",                        group = gX)
colorBars = input.bool(false, "رنگ کندل بر اساس امتیاز",         group = gX)
showVP    = input.bool(false, "پروفایل حجم (POC/VAH/VAL)",       group = gX)
vpLook    = input.int(200, "دوره پروفایل حجم", minval = 30, maxval = 1000, group = gX)
vpBins    = input.int(40,  "تعداد ردیف",       minval = 10, maxval = 120,  group = gX)

// ───────────────────────────────── HELPERS ────────────────────────────────
clamp(float x, float lo, float hi) => math.max(lo, math.min(hi, x))
shortSym(string s) =>
    int    p = str.pos(s, ":")
    string t = na(p) ? s : str.substring(s, p + 1)
    t := str.replace_all(t, "USDT.P", "")
    t := str.replace_all(t, "USDT", "")
    t := str.replace_all(t, "PERP", "")
    t
gradeRank(string g) => g == "A+" ? 3 : g == "A" ? 2 : 1

// ══════════════════ SHARED SCORING ENGINE (per symbol) ════════════════════
f_engine() =>
    float a   = math.max(ta.atr(atrLen), syminfo.mintick)
    float ef  = ta.ema(close, emaFastLen)
    float es  = ta.ema(close, emaSlowLen)
    float e2  = ta.ema(close, 200)
    float r   = ta.rsi(close, rsiLen)
    [_ml, _ms, mh] = ta.macd(close, 12, 26, 9)
    float stc = ta.sma(ta.stoch(close, high, low, 14), 3)
    [_stl, sdir]   = ta.supertrend(stFactor, stAtr)
    [_dp, _dm, ax] = ta.dmi(14, 14)
    float vw  = ta.vwap(hlc3)
    float vr  = volume / math.max(ta.sma(volume, 20), 1e-10)
    float br  = math.max(high - low, syminfo.mintick)
    float cv  = ta.cum(((close - open) / br) * volume)
    float cs  = ta.linreg(cv, 20, 0) - ta.linreg(cv, 20, 1)
    float cn  = cs / math.max(ta.stdev(cv - cv[1], 50), 1e-10)

    float f1 = clamp(((ef - es) / a) * 1.5, -1, 1) * 0.6 + clamp((close - e2) / (a * 4), -1, 1) * 0.4
    float f2 = sdir < 0 ? 1.0 : -1.0
    float f3 = clamp((r - 50) / 25, -1, 1)
    float f4 = clamp((mh / a) * 4, -1, 1)
    float f5 = clamp((stc - 50) / 40, -1, 1)
    float f6 = clamp(cn / 2.0, -1, 1)
    float f7 = clamp((close - vw) / (a * 2), -1, 1)

    float ws = wTrend + wST + wRSI + wMACD + wStoch + wVol + wVWAP
    float sc = ws > 0 ? clamp((f1 * wTrend + f2 * wST + f3 * wRSI + f4 * wMACD + f5 * wStoch + f6 * wVol + f7 * wVWAP) / ws, -1, 1) : 0.0

    int ag = 0
    ag += math.sign(f1) == math.sign(sc) ? 1 : 0
    ag += math.sign(f2) == math.sign(sc) ? 1 : 0
    ag += math.sign(f3) == math.sign(sc) ? 1 : 0
    ag += math.sign(f4) == math.sign(sc) ? 1 : 0
    ag += math.sign(f5) == math.sign(sc) ? 1 : 0
    ag += math.sign(f6) == math.sign(sc) ? 1 : 0
    ag += math.sign(f7) == math.sign(sc) ? 1 : 0
    float agp = ag / 7.0
    float cf  = clamp(math.abs(sc) * 100 * (0.55 + 0.45 * clamp(ax / 30.0, 0, 1.2)) * (0.85 + 0.15 * clamp(vr, 0.4, 2.0)) * (0.6 + 0.6 * agp), 0, 99)
    float fr  = ta.crossover(sc, sigThreshold) ? 1.0 : ta.crossunder(sc, -sigThreshold) ? -1.0 : 0.0
    [sc, cf, ax, fr]

// ──────────────────────────── BASE CALCULATIONS ───────────────────────────
atr      = ta.atr(atrLen)
atrSafe  = math.max(atr, syminfo.mintick)
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
ema200   = ta.ema(close, 200)
rsi      = ta.rsi(close, rsiLen)
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
stochK   = ta.sma(ta.stoch(close, high, low, 14), 3)
[stLine, stDir] = ta.supertrend(stFactor, stAtr)
[diPlus, diMinus, adxV] = ta.dmi(14, 14)
vwapV    = ta.vwap(hlc3)
volAvg   = ta.sma(volume, 20)
volRatio = volume / math.max(volAvg, 1e-10)

barRange = math.max(high - low, syminfo.mintick)
delta    = ((close - open) / barRange) * volume
cvd      = ta.cum(delta)
cvdSlope = ta.linreg(cvd, 20, 0) - ta.linreg(cvd, 20, 1)
cvdNorm  = cvdSlope / math.max(ta.stdev(cvd - cvd[1], 50), 1e-10)

htfEmaF  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 21), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
htfEmaS  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 50), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
htfRsi   = request.security(syminfo.tickerid, htfTF, ta.rsi(close, 14), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)

// ══════════════════════════ LIQUIDITY ENGINE ══════════════════════════════
type Liq
    float price
    int   barIdx
    bool  isHigh
    bool  swept
    bool  strong
    line  ln
    label lb

var array<Liq> pools = array.new<Liq>()

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)

drawLiq(Liq q) => showLiq and (not onlyStrong or q.strong)

addPool(float p, bool isHigh) =>
    bool merged = false
    if array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Liq q = array.get(pools, i)
            if not q.swept and q.isHigh == isHigh and math.abs(q.price - p) <= eqTol * atrSafe
                q.strong := true
                q.price  := math.avg(q.price, p)
                if na(q.ln) and drawLiq(q)
                    q.ln := line.new(q.barIdx, q.price, bar_index, q.price, color = isHigh ? colBSL : colSSL, width = 2)
                if not na(q.ln)
                    line.set_y1(q.ln, q.price)
                    line.set_y2(q.ln, q.price)
                    line.set_width(q.ln, 2)
                merged := true
                break
    if not merged
        color col = isHigh ? colBSL : colSSL
        line  ln  = na
        if showLiq and not onlyStrong
            ln := line.new(bar_index - pivLen, p, bar_index, p, color = col, width = 1)
        array.push(pools, Liq.new(price = p, barIdx = bar_index - pivLen, isHigh = isHigh, swept = false, strong = false, ln = ln, lb = na))
    merged

if not na(ph)
    addPool(ph, true)
if not na(pl)
    addPool(pl, false)

cleanup(bool isHigh) =>
    int cnt = 0
    if array.size(pools) > 0
        for i = array.size(pools) - 1 to 0
            Liq q = array.get(pools, i)
            if q.isHigh == isHigh and not q.swept
                cnt += 1
        if cnt > maxPools
            int toDrop = cnt - maxPools
            for i = 0 to array.size(pools) - 1
                if toDrop <= 0
                    break
                if i < array.size(pools)
                    Liq q = array.get(pools, i)
                    if q.isHigh == isHigh and not q.swept
                        line.delete(q.ln)
                        label.delete(q.lb)
                        array.remove(pools, i)
                        toDrop -= 1
    cnt

cleanup(true)
cleanup(false)

var bool sweepUp   = false
var bool sweepDown = false
sweepUp   := false
sweepDown := false
float swpLvlUp   = na
float swpLvlDown = na
float liqAbove = 0.0
float liqBelow = 0.0
float nearAbove = na
float nearBelow = na

if array.size(pools) > 0
    for i = array.size(pools) - 1 to 0
        if i < array.size(pools)
            Liq q = array.get(pools, i)
            if q.swept and (hideSwept or bar_index - q.barIdx > 400)
                line.delete(q.ln)
                label.delete(q.lb)
                array.remove(pools, i)
            else if not q.swept
                bool hit = q.isHigh ? high > q.price : low < q.price
                if hit
                    q.swept := true
                    if not na(q.ln)
                        line.set_x2(q.ln, bar_index)
                        line.set_style(q.ln, line.style_dotted)
                        line.set_color(q.ln, color.new(color.gray, 60))
                    if showSwept and showLiq
                        q.lb := label.new(bar_index, q.price, "✖",
                             style = q.isHigh ? label.style_label_down : label.style_label_up,
                             color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
                    if q.isHigh
                        sweepUp   := true
                        swpLvlUp  := q.price
                    else
                        sweepDown  := true
                        swpLvlDown := q.price
                else
                    if not na(q.ln)
                        line.set_x2(q.ln, bar_index + 3)
                        line.set_width(q.ln, q.strong ? 2 : 1)
                    float dist = math.abs(q.price - close) / atrSafe
                    float w    = (q.strong ? 2.0 : 1.0) / (1.0 + dist)
                    if q.price > close
                        liqAbove += w
                        nearAbove := na(nearAbove) ? q.price : math.min(nearAbove, q.price)
                    else
                        liqBelow += w
                        nearBelow := na(nearBelow) ? q.price : math.max(nearBelow, q.price)

liqMagnet = (liqAbove + liqBelow) > 0 ? (liqAbove - liqBelow) / (liqAbove + liqBelow) : 0.0

// ═════════════════════ VOLUME PROFILE (اختیاری) ═══════════════════════════
var line pocLn = na
var line vahLn = na
var line valLn = na
var float poc = na
var float vah = na
var float val = na

if showVP and barstate.islast
    int   look = int(math.max(10, math.min(vpLook, bar_index)))
    float hh = ta.highest(high, look)
    float ll = ta.lowest(low, look)
    float step = (hh - ll) / vpBins
    if step > 0
        array<float> binVol = array.new_float(vpBins, 0.0)
        for b = 0 to look - 1
            float c = (nz(high[b]) + nz(low[b])) / 2.0
            if c > 0
                int idx = int(math.min(vpBins - 1, math.max(0, int((c - ll) / step))))
                array.set(binVol, idx, array.get(binVol, idx) + nz(volume[b]))
        int   pocIdx = array.indexof(binVol, array.max(binVol))
        float total  = array.sum(binVol)
        poc := ll + (pocIdx + 0.5) * step
        float acc = array.get(binVol, pocIdx)
        int lo = pocIdx
        int hi = pocIdx
        while acc < total * 0.7 and (lo > 0 or hi < vpBins - 1)
            float dn = lo > 0 ? array.get(binVol, lo - 1) : -1.0
            float up = hi < vpBins - 1 ? array.get(binVol, hi + 1) : -1.0
            if up >= dn
                hi += 1
                acc += math.max(up, 0)
            else
                lo -= 1
                acc += math.max(dn, 0)
        vah := ll + (hi + 0.5) * step
        val := ll + (lo + 0.5) * step
        line.delete(pocLn)
        line.delete(vahLn)
        line.delete(valLn)
        pocLn := line.new(bar_index - look, poc, bar_index + 6, poc, color = color.new(color.orange, 0),  width = 2)
        vahLn := line.new(bar_index - look, vah, bar_index + 6, vah, color = color.new(color.orange, 60), style = line.style_dashed)
        valLn := line.new(bar_index - look, val, bar_index + 6, val, color = color.new(color.orange, 60), style = line.style_dashed)

// ═══════════════════════ FACTOR SCORES  (−1 … +1) ═════════════════════════
sTrend = clamp(((emaFast - emaSlow) / atrSafe) * 1.5, -1, 1) * 0.6 + clamp((close - ema200) / (atrSafe * 4), -1, 1) * 0.4
sST    = stDir < 0 ? 1.0 : -1.0
sRSI   = clamp((rsi - 50) / 25, -1, 1)
sMACD  = clamp((macdH / atrSafe) * 4, -1, 1)
sStoch = clamp((stochK - 50) / 40, -1, 1)
sVol   = clamp(cvdNorm / 2.0, -1, 1)
sVWAP  = clamp((close - vwapV) / (atrSafe * 2), -1, 1)
sHTF   = clamp(((nz(htfEmaF, emaSlow) - nz(htfEmaS, emaSlow)) / atrSafe) * 1.2, -1, 1) * 0.6 + clamp((nz(htfRsi, 50) - 50) / 25, -1, 1) * 0.4
sLiq   = clamp(liqMagnet * 1.2, -1, 1)

sweepBonus = sweepDown and close > open ? 0.25 : sweepUp and close < open ? -0.25 : 0.0

array<float> fScore = array.from(sTrend, sST, sRSI, sMACD, sStoch, sVol, sVWAP, sHTF, sLiq)
array<float> fBaseW = array.from(wTrend, wST, wRSI, wMACD, wStoch, wVol, wVWAP, wHTF, wLiq)
nFac = array.size(fScore)

// ───────────────── ADAPTIVE WEIGHTS (online learning) ─────────────────────
var array<float> perf  = array.new_float(9, 0.0)
var array<float> histQ = array.new_float()

for i = 0 to nFac - 1
    array.push(histQ, array.get(fScore, i))

if array.size(histQ) > nFac * evalBars
    float fwdRet = (close - close[evalBars]) / math.max(nz(atr[evalBars], atrSafe), syminfo.mintick)
    float retN   = clamp(fwdRet / 2.0, -1, 1)
    for i = 0 to nFac - 1
        float sOld = array.get(histQ, 0)
        array.remove(histQ, 0)
        float hit = clamp(sOld * retN * 2.0, -1, 1)
        array.set(perf, i, array.get(perf, i) * (1 - learnRate) + learnRate * hit)

getMult(int i) => adaptive ? clamp(1.0 + array.get(perf, i) * 2.0, 0.25, 2.0) : 1.0

float wSum = 0.0
float sSum = 0.0
int   agree = 0
for i = 0 to nFac - 1
    float w = array.get(fBaseW, i) * getMult(i)
    wSum += w
    sSum += w * array.get(fScore, i)

score = wSum > 0 ? clamp(sSum / wSum + sweepBonus, -1, 1) : 0.0

for i = 0 to nFac - 1
    if math.sign(array.get(fScore, i)) == math.sign(score) and array.get(fScore, i) != 0
        agree += 1
agreePct = nFac > 0 ? agree / float(nFac) : 0.0

adxF = clamp(adxV / 30.0, 0, 1.2)
volF = clamp(volRatio, 0.4, 2.0)
conf = clamp(math.abs(score) * 100 * (0.55 + 0.45 * adxF) * (0.85 + 0.15 * volF) * (0.6 + 0.6 * agreePct), 0, 99)

regime = adxV >= 25 ? "روندی 🚀" : adxV >= 18 ? "در حال شکل‌گیری" : "رِنج 🌀"
atrPct = atr / close * 100

// ══════════════════ ADVANCED SIGNAL ENGINE (v3) ═══════════════════════════
// فیلترها
ext        = math.abs(close - emaSlow) / atrSafe
volOK      = not useVolFilter or volRatio >= minVolRatio
extOK      = ext <= maxExt
adxOK      = not useAdx or adxV >= adxMin
htfLongOK  = not useHTF or sHTF >  0.05
htfShortOK = not useHTF or sHTF < -0.05

// موتور ۱: روندی (عبور امتیاز از آستانه)
trendLong  = ta.crossover(score,  sigThreshold)  and htfLongOK  and adxOK
trendShort = ta.crossunder(score, -sigThreshold) and htfShortOK and adxOK

// موتور ۲: بازگشتی (شکار نقدینگی + بازپس‌گیری سطح)
revLong  = sweepDown and close > open and close > nz(swpLvlDown, close) and rsi < 52 and score > -0.20
revShort = sweepUp   and close < open and close < nz(swpLvlUp,   close) and rsi > 48 and score <  0.20

allowTrend = sigMode != "فقط بازگشتی"
allowRev   = sigMode != "فقط روندی"

rawLong  = (allowTrend and trendLong)  or (allowRev and revLong)
rawShort = (allowTrend and trendShort) or (allowRev and revShort)
isRev    = (revLong or revShort) and not (trendLong or trendShort)

// کیفیت سیگنال (تعداد هم‌سویی‌ها)
conflPts(int d) =>
    int p = 0
    p += (d == 1 ? sHTF >  0.05 : sHTF < -0.05) ? 1 : 0
    p += (d == 1 ? sST  >  0    : sST  <  0)    ? 1 : 0
    p += (d == 1 ? sVol >  0.10 : sVol < -0.10) ? 1 : 0
    p += (d == 1 ? sLiq >  0.10 : sLiq < -0.10) ? 1 : 0
    p += volRatio >= 1.2 ? 1 : 0
    p += adxV >= 22 ? 1 : 0
    p += conf >= 70 ? 1 : 0
    p

pts     = conflPts(rawLong ? 1 : -1)
gradeS  = pts >= 6 ? "A+" : pts >= 4 ? "A" : "B"
gradeOK = gradeRank(gradeS) >= gradeRank(minGrade)
float confReq = isRev ? minConf * 0.8 : minConf * 1.0

var int lastSigBar = -1000
canFire = bar_index - lastSigBar > cooldownBars

longSig  = rawLong  and conf >= confReq and volOK and extOK and gradeOK and canFire and barstate.isconfirmed
shortSig = rawShort and conf >= confReq and volOK and extOK and gradeOK and canFire and barstate.isconfirmed

// ───────────────────── TRADE MANAGEMENT & STATS ───────────────────────────
var int    posDir  = 0
var float  pEntry  = na
var float  pSL     = na
var float  pTP1    = na
var float  pTP2    = na
var float  pRisk   = na
var bool   tp1Hit  = false
var string pGrade  = ""
var string pType   = ""
var int    wins    = 0
var int    losses  = 0
var float  sumR    = 0.0

var line  enLn = na
var line  slLn = na
var line  t1Ln = na
var line  t2Ln = na
var box   rBox = na
var box   wBox = na
var label rrLb = na

// باز کردن معامله جدید
if longSig or shortSig
    lastSigBar := bar_index
    posDir  := longSig ? 1 : -1
    pEntry  := close
    pRisk   := slAtrMult * atr
    pSL     := longSig ? close - pRisk : close + pRisk
    pTP1    := longSig ? close + pRisk * tp1RR : close - pRisk * tp1RR
    pTP2    := longSig ? close + pRisk * tp2RR : close - pRisk * tp2RR
    tp1Hit  := false
    pGrade  := gradeS
    pType   := isRev ? "بازگشتی 💧" : "روندی 📈"

    line.delete(enLn)
    line.delete(slLn)
    line.delete(t1Ln)
    line.delete(t2Ln)
    box.delete(rBox)
    box.delete(wBox)
    label.delete(rrLb)

    if showLvls
        enLn := line.new(bar_index, pEntry, bar_index + 8, pEntry, color = color.new(color.blue, 10), style = line.style_dashed, width = 1)
        slLn := line.new(bar_index, pSL,    bar_index + 8, pSL,    color = color.new(#ef5350, 0), width = 2)
        t1Ln := line.new(bar_index, pTP1,   bar_index + 8, pTP1,   color = color.new(#26a69a, 40), style = line.style_dashed)
        t2Ln := line.new(bar_index, pTP2,   bar_index + 8, pTP2,   color = color.new(#26a69a, 0), width = 2)
    if showZones
        rBox := box.new(bar_index, math.max(pEntry, pSL),  bar_index + 8, math.min(pEntry, pSL),
             border_color = color.new(#ef5350, 70), bgcolor = color.new(#ef5350, 88))
        wBox := box.new(bar_index, math.max(pEntry, pTP2), bar_index + 8, math.min(pEntry, pTP2),
             border_color = color.new(#26a69a, 70), bgcolor = color.new(#26a69a, 88))
    if showRR
        rrLb := label.new(bar_index + 8, pTP2, "TP2 · R:R 1:" + str.tostring(tp2RR, "#.#"),
             style = label.style_label_left, color = color.new(#26a69a, 15), textcolor = color.white, size = size.tiny)
    if showSig
        label.new(bar_index, longSig ? low - atr * 0.6 : high + atr * 0.6,
             (longSig ? "▲ BUY " : "▼ SELL ") + pGrade + "\n" + str.tostring(conf, "#") + "%  ·  R:R 1:" + str.tostring(tp2RR, "#.#") + "\n" + pType,
             style = longSig ? label.style_label_up : label.style_label_down,
             color = longSig ? color.new(#26a69a, 0) : color.new(#ef5350, 0),
             textcolor = color.white, size = size.normal)

// مدیریت معامله باز
else if posDir != 0
    if showLvls and not na(enLn)
        line.set_x2(enLn, bar_index + 3)
        line.set_x2(slLn, bar_index + 3)
        line.set_x2(t1Ln, bar_index + 3)
        line.set_x2(t2Ln, bar_index + 3)
        line.set_y1(slLn, pSL)
        line.set_y2(slLn, pSL)
    if showZones and not na(rBox)
        box.set_right(rBox, bar_index + 3)
        box.set_right(wBox, bar_index + 3)
        box.set_top(rBox,    math.max(pEntry, pSL))
        box.set_bottom(rBox, math.min(pEntry, pSL))
    if showRR and not na(rrLb)
        label.set_x(rrLb, bar_index + 3)

    bool hitTP1 = posDir == 1 ? high >= pTP1 : low  <= pTP1
    bool hitTP2 = posDir == 1 ? high >= pTP2 : low  <= pTP2
    bool hitSL  = posDir == 1 ? low  <= pSL  : high >= pSL

    if not tp1Hit and hitTP1 and not hitSL
        tp1Hit := true
        if useBE
            pSL := pEntry
        if showExit
            label.new(bar_index, pTP1, "TP1 ✅", style = label.style_label_left,
                 color = color.new(#26a69a, 25), textcolor = color.white, size = size.tiny)
    if hitTP2
        float r = tp1Hit ? (tp1RR * 0.5 + tp2RR * 0.5) : tp2RR
        sumR += r
        wins += 1
        if showExit
            label.new(bar_index, pTP2, "TP2 🎯 +" + str.tostring(r, "#.#") + "R", style = label.style_label_left,
                 color = color.new(#26a69a, 0), textcolor = color.white, size = size.tiny)
        posDir := 0
    else if hitSL
        float r = tp1Hit ? tp1RR * 0.5 : -1.0
        sumR += r
        if r >= 0
            wins += 1
        else
            losses += 1
        if showExit
            label.new(bar_index, pSL, (r >= 0 ? "BE ⚖️ +" : "SL ❌ ") + str.tostring(r, "#.#") + "R",
                 style = label.style_label_left,
                 color = color.new(r >= 0 ? color.gray : #ef5350, 10), textcolor = color.white, size = size.tiny)
        posDir := 0

// فلش سیگنال (همیشه واضح روی چارت)
plotshape(showArrow and longSig,  title = "BUY arrow",  style = shape.triangleup,
     location = location.belowbar, color = color.new(#26a69a, 0), size = size.small)
plotshape(showArrow and shortSig, title = "SELL arrow", style = shape.triangledown,
     location = location.abovebar, color = color.new(#ef5350, 0), size = size.small)

// سود/زیان لحظه‌ای
curR = posDir == 0 or na(pEntry) or na(pRisk) or pRisk == 0 ? 0.0 : (close - pEntry) / pRisk * posDir
winRate = (wins + losses) > 0 ? wins / float(wins + losses) * 100 : 0.0

// ───────────────────────── نمایش‌های اختیاری ──────────────────────────────
pFast = plot(showEma ? emaFast : na, "EMA سریع", color = color.new(color.aqua, 55))
pSlow = plot(showEma ? emaSlow : na, "EMA کند",  color = color.new(color.orange, 55))
fill(pFast, pSlow, color = showEma ? (emaFast > emaSlow ? color.new(#26a69a, 90) : color.new(#ef5350, 90)) : na)
plot(showVwap ? vwapV : na, "VWAP", color = color.new(color.purple, 35))

scoreCol = score > 0 ? color.new(#26a69a, int(math.max(0, 85 - math.abs(score) * 85)))
                     : color.new(#ef5350, int(math.max(0, 85 - math.abs(score) * 85)))
barcolor(colorBars ? scoreCol : na)

// ═══════════════════════ MULTI-SYMBOL SCANNER (15) ════════════════════════
scTF = scanTF == "" ? timeframe.period : scanTF
[c1,  k1,  x1,  r1]  = request.security(sym1,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c2,  k2,  x2,  r2]  = request.security(sym2,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c3,  k3,  x3,  r3]  = request.security(sym3,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c4,  k4,  x4,  r4]  = request.security(sym4,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c5,  k5,  x5,  r5]  = request.security(sym5,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c6,  k6,  x6,  r6]  = request.security(sym6,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c7,  k7,  x7,  r7]  = request.security(sym7,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c8,  k8,  x8,  r8]  = request.security(sym8,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c9,  k9,  x9,  r9]  = request.security(sym9,  scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c10, k10, x10, r10] = request.security(sym10, scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c11, k11, x11, r11] = request.security(sym11, scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c12, k12, x12, r12] = request.security(sym12, scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c13, k13, x13, r13] = request.security(sym13, scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c14, k14, x14, r14] = request.security(sym14, scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)
[c15, k15, x15, r15] = request.security(sym15, scTF, f_engine(), lookahead = barmerge.lookahead_off,
     calc_bars_count = scanBars, ignore_invalid_symbol = true)

// ───────────────────────────── DASHBOARD ──────────────────────────────────
f_pos(string p) =>
    switch p
        "بالا-راست"   => position.top_right
        "بالا-چپ"     => position.top_left
        "پایین-راست"  => position.bottom_right
        "پایین-چپ"    => position.bottom_left
        => position.middle_right

scoreBar(float s) =>
    float v = nz(s, 0.0)
    int filled = int(math.max(1, math.min(5, math.round(math.abs(v) * 5))))
    str.repeat(v >= 0 ? "▰" : "▱", filled) + (filled < 5 ? str.repeat("·", 5 - filled) : "")

useTable = panelMode == "جدول (دسکتاپ)" or panelMode == "هر دو"
useLabel = panelMode == "برچسب روی چارت (موبایل)" or panelMode == "هر دو"

// مقادیر مشترک پنل
bias    = score > sigThreshold ? "خرید ▲" : score < -sigThreshold ? "فروش ▼" : "خنثی ■"
biasCol = score > sigThreshold ? #26a69a : score < -sigThreshold ? #ef5350 : color.gray
planTxt = posDir == 0 or na(pEntry) ? "بدون معامله فعال" :
     (posDir == 1 ? "LONG " : "SHORT ") + pGrade + " · ورود " + str.tostring(pEntry, format.mintick) +
     " · SL " + str.tostring(pSL, format.mintick) + " · TP " + str.tostring(pTP2, format.mintick)
statsTxt = not showStats ? "" :
     "📊 " + str.tostring(wins) + "W / " + str.tostring(losses) + "L · WR " + str.tostring(winRate, "#") + "% · " +
     (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.#") + "R" +
     (posDir != 0 ? "  |  جاری: " + (curR >= 0 ? "+" : "") + str.tostring(curR, "#.##") + "R" : "")

// ═════════════════════ جدول داشبورد (دسکتاپ) ═════════════════════════════
var table dash = table.new(f_pos(dashPos), 3, dashFull ? 19 : 9, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 60), bgcolor = color.new(#131722, 10))

fillRow(table t, int row, int cols) =>
    for c = 0 to cols - 1
        table.cell(t, c, row, "")

rowFactor(int r, string name, float s, int idx) =>
    col = s > 0.1 ? #26a69a : s < -0.1 ? #ef5350 : color.gray
    table.cell(dash, 0, r, name, text_size = size.tiny, text_color = color.new(color.white, 25), text_halign = text.align_left)
    table.cell(dash, 1, r, scoreBar(s), text_size = size.tiny, text_color = col)
    table.cell(dash, 2, r, adaptive ? "×" + str.tostring(getMult(idx), "#.0#") : str.tostring(s, "#.00"),
         text_size = size.tiny, text_color = color.new(color.silver, 20))

if showDash and useTable and barstate.islast
    fillRow(dash, 0, 3)
    table.cell(dash, 0, 0, "🧠 " + shortSym(syminfo.ticker) + " · " + timeframe.period,
         text_size = size.small, text_color = color.white, bgcolor = color.new(#2962ff, 20))
    table.merge_cells(dash, 0, 0, 2, 0)

    table.cell(dash, 0, 1, "جهت", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 1, bias, text_size = size.small, text_color = color.white, bgcolor = color.new(biasCol, 35))
    table.cell(dash, 2, 1, str.tostring(score, "#.00"), text_size = size.tiny, text_color = color.white)

    table.cell(dash, 0, 2, "اطمینان", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 2, str.tostring(conf, "#") + "%", text_size = size.small, text_color = color.white,
         bgcolor = color.new(conf >= 70 ? #26a69a : conf >= 50 ? color.orange : color.gray, 40))
    table.cell(dash, 2, 2, "کیفیت " + gradeS, text_size = size.tiny,
         text_color = gradeS == "A+" ? #26a69a : gradeS == "A" ? color.orange : color.silver)

    table.cell(dash, 0, 3, "رژیم بازار", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 3, regime, text_size = size.tiny, text_color = color.white)
    table.cell(dash, 2, 3, "ADX " + str.tostring(adxV, "#"), text_size = size.tiny, text_color = color.silver)

    table.cell(dash, 0, 4, "نقدینگی ↑ / ↓", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 4, na(nearAbove) ? "—" : str.tostring(nearAbove, format.mintick), text_size = size.tiny, text_color = #ef5350)
    table.cell(dash, 2, 4, na(nearBelow) ? "—" : str.tostring(nearBelow, format.mintick), text_size = size.tiny, text_color = #26a69a)

    table.cell(dash, 0, 5, "مغناطیس نقدینگی", text_size = size.tiny, text_color = color.silver, text_halign = text.align_left)
    table.cell(dash, 1, 5, scoreBar(sLiq), text_size = size.tiny, text_color = sLiq > 0 ? #ef5350 : #26a69a)
    table.cell(dash, 2, 5, sLiq > 0.15 ? "به بالا" : sLiq < -0.15 ? "به پایین" : "متعادل", text_size = size.tiny, text_color = color.silver)

    fillRow(dash, 6, 3)
    table.cell(dash, 0, 6, planTxt, text_size = size.tiny, text_color = color.white,
         bgcolor = color.new(posDir == 1 ? #26a69a : posDir == -1 ? #ef5350 : color.gray, 60))
    table.merge_cells(dash, 0, 6, 2, 6)

    int rowStats = dashFull ? 17 : 7
    int rowSign  = dashFull ? 18 : 8

    if dashFull
        rowFactor(7,  "روند EMA",       sTrend, 0)
        rowFactor(8,  "SuperTrend",     sST,    1)
        rowFactor(9,  "RSI",            sRSI,   2)
        rowFactor(10, "MACD",           sMACD,  3)
        rowFactor(11, "Stochastic",     sStoch, 4)
        rowFactor(12, "فشار حجم",        sVol,   5)
        rowFactor(13, "VWAP",           sVWAP,  6)
        rowFactor(14, "HTF " + htfTF,   sHTF,   7)
        rowFactor(15, "مغناطیس نقدینگی", sLiq,   8)
        fillRow(dash, 16, 3)
        table.cell(dash, 0, 16, "ATR " + str.tostring(atrPct, "#.##") + "% · حجم ×" + str.tostring(volRatio, "#.0"),
             text_size = size.tiny, text_color = color.new(color.silver, 20))
        table.merge_cells(dash, 0, 16, 2, 16)

    fillRow(dash, rowStats, 3)
    table.cell(dash, 0, rowStats, statsTxt == "" ? "—" : statsTxt, text_size = size.tiny, text_color = color.white,
         bgcolor = color.new(sumR > 0 ? #26a69a : sumR < 0 ? #ef5350 : color.gray, 70))
    table.merge_cells(dash, 0, rowStats, 2, rowStats)

    fillRow(dash, rowSign, 3)
    table.cell(dash, 0, rowSign, "✍️ " + sigText, text_size = size.tiny,
         text_color = color.new(color.white, 10), bgcolor = color.new(#2962ff, 45))
    table.merge_cells(dash, 0, rowSign, 2, rowSign)

// ═══════════════════ اسکنر: آماده‌سازی داده‌ها ════════════════════════════
scanTxt() =>
    array<string> names = array.from(shortSym(sym1),  shortSym(sym2),  shortSym(sym3),  shortSym(sym4),  shortSym(sym5),
                                     shortSym(sym6),  shortSym(sym7),  shortSym(sym8),  shortSym(sym9),  shortSym(sym10),
                                     shortSym(sym11), shortSym(sym12), shortSym(sym13), shortSym(sym14), shortSym(sym15))
    array<float> scs = array.from(nz(c1), nz(c2), nz(c3), nz(c4), nz(c5), nz(c6), nz(c7), nz(c8),
                                  nz(c9), nz(c10), nz(c11), nz(c12), nz(c13), nz(c14), nz(c15))
    array<float> cfs = array.from(nz(k1), nz(k2), nz(k3), nz(k4), nz(k5), nz(k6), nz(k7), nz(k8),
                                  nz(k9), nz(k10), nz(k11), nz(k12), nz(k13), nz(k14), nz(k15))
    array<float> frs = array.from(nz(r1), nz(r2), nz(r3), nz(r4), nz(r5), nz(r6), nz(r7), nz(r8),
                                  nz(r9), nz(r10), nz(r11), nz(r12), nz(r13), nz(r14), nz(r15))
    string out = ""
    array<int> ordIdx = array.sort_indices(cfs, order.descending)
    int shown = 0
    for j = 0 to array.size(ordIdx) - 1
        if shown < 10
            int   k  = array.get(ordIdx, j)
            float sc = array.get(scs, k)
            float cf = array.get(cfs, k)
            float fr = array.get(frs, k)
            bool  ok = cf >= minConf and math.abs(sc) >= sigThreshold
            if (not scanReady or ok) and cf > 0
                string st = fr != 0 and ok ? "🔥" : ok ? "✅" : "·"
                out := out + st + " " + array.get(names, k) + "  " + (sc > 0 ? "▲" : "▼") + "  " +
                     str.tostring(cf, "#") + "%\n"
                shown += 1
    out

// ═════════════════════ جدول اسکنر (دسکتاپ) ═══════════════════════════════
var table scan = table.new(f_pos(scanPos), 5, 17, border_width = 1,
     frame_width = 1, frame_color = color.new(color.gray, 60), bgcolor = color.new(#131722, 10))

if showScan and useTable and barstate.islast
    array<string> names = array.from(shortSym(sym1),  shortSym(sym2),  shortSym(sym3),  shortSym(sym4),  shortSym(sym5),
                                     shortSym(sym6),  shortSym(sym7),  shortSym(sym8),  shortSym(sym9),  shortSym(sym10),
                                     shortSym(sym11), shortSym(sym12), shortSym(sym13), shortSym(sym14), shortSym(sym15))
    array<float> scs = array.from(nz(c1), nz(c2), nz(c3), nz(c4), nz(c5), nz(c6), nz(c7), nz(c8),
                                  nz(c9), nz(c10), nz(c11), nz(c12), nz(c13), nz(c14), nz(c15))
    array<float> cfs = array.from(nz(k1), nz(k2), nz(k3), nz(k4), nz(k5), nz(k6), nz(k7), nz(k8),
                                  nz(k9), nz(k10), nz(k11), nz(k12), nz(k13), nz(k14), nz(k15))
    array<float> frs = array.from(nz(r1), nz(r2), nz(r3), nz(r4), nz(r5), nz(r6), nz(r7), nz(r8),
                                  nz(r9), nz(r10), nz(r11), nz(r12), nz(r13), nz(r14), nz(r15))

    fillRow(scan, 0, 5)
    table.cell(scan, 0, 0, "🔎 اسکنر ۱۵ ارز · " + scTF, text_size = size.small, text_color = color.white, bgcolor = color.new(#2962ff, 20))
    table.merge_cells(scan, 0, 0, 4, 0)
    table.cell(scan, 0, 1, "ارز",     text_size = size.tiny, text_color = color.new(color.white, 30))
    table.cell(scan, 1, 1, "جهت",    text_size = size.tiny, text_color = color.new(color.white, 30))
    table.cell(scan, 2, 1, "امتیاز",  text_size = size.tiny, text_color = color.new(color.white, 30))
    table.cell(scan, 3, 1, "اطمینان", text_size = size.tiny, text_color = color.new(color.white, 30))
    table.cell(scan, 4, 1, "وضعیت",  text_size = size.tiny, text_color = color.new(color.white, 30))

    array<int> ordIdx = array.sort_indices(cfs, order.descending)
    int row = 2
    for j = 0 to array.size(ordIdx) - 1
        if row <= 16
            int   k  = array.get(ordIdx, j)
            float sc = array.get(scs, k)
            float cf = array.get(cfs, k)
            float fr = array.get(frs, k)
            bool  ok = cf >= minConf and math.abs(sc) >= sigThreshold
            if (not scanReady or ok) and cf > 0
                string dirTxt = sc > 0 ? "▲ خرید" : sc < 0 ? "▼ فروش" : "■"
                color  dirCol = sc > 0.05 ? #26a69a : sc < -0.05 ? #ef5350 : color.gray
                string stat   = fr != 0 and ok ? "🔥 ورود تازه" : ok ? "✅ آماده" : cf >= minConf * 0.7 ? "…" : "—"
                table.cell(scan, 0, row, array.get(names, k), text_size = size.tiny, text_color = color.white)
                table.cell(scan, 1, row, dirTxt, text_size = size.tiny, text_color = color.white, bgcolor = color.new(dirCol, 55))
                table.cell(scan, 2, row, scoreBar(sc), text_size = size.tiny, text_color = dirCol)
                table.cell(scan, 3, row, str.tostring(cf, "#") + "%", text_size = size.tiny, text_color = color.white,
                     bgcolor = color.new(cf >= 70 ? #26a69a : cf >= minConf ? color.orange : color.gray, 65))
                table.cell(scan, 4, row, stat, text_size = size.tiny,
                     text_color = fr != 0 and ok ? color.yellow : ok ? #26a69a : color.new(color.silver, 30))
                row += 1

// ═══════════ پنل برچسبی روی چارت (سازگار با موبایل) ══════════════════════
var label panelLb = na
var label scanLb  = na
hiRef60 = ta.highest(high, 60)
loRef60 = ta.lowest(low, 60)

if barstate.islast and useLabel
    float hiRef = hiRef60
    float loRef = loRef60
    if showDash
        string txt = "🧠 " + shortSym(syminfo.ticker) + " · " + timeframe.period + "\n" +
             "جهت: " + bias + "   (" + str.tostring(score, "#.00") + ")\n" +
             "اطمینان: " + str.tostring(conf, "#") + "%   کیفیت: " + gradeS + "\n" +
             "رژیم: " + regime + "   ADX " + str.tostring(adxV, "#") + "\n" +
             "نقدینگی ↑ " + (na(nearAbove) ? "—" : str.tostring(nearAbove, format.mintick)) +
             "   ↓ " + (na(nearBelow) ? "—" : str.tostring(nearBelow, format.mintick)) + "\n" +
             planTxt + "\n" +
             (statsTxt == "" ? "" : statsTxt + "\n") +
             "✍️ " + sigText
        label.delete(panelLb)
        panelLb := label.new(bar_index, hiRef + atr * 2, txt, style = label.style_label_left,
             color = color.new(#131722, 15), textcolor = color.white, size = size.small,
             textalign = text.align_left)
    if showScan
        string st = scanTxt()
        label.delete(scanLb)
        scanLb := label.new(bar_index, loRef - atr * 2,
             "🔎 اسکنر " + scTF + "\n" + (st == "" ? "فرصتی نیست" : st) + "✍️ " + sigText,
             style = label.style_label_left, color = color.new(#131722, 15),
             textcolor = color.white, size = size.small, textalign = text.align_left)

// ───────────────────────────── ALERTS ─────────────────────────────────────
alertcondition(longSig,   "🟢 سیگنال خرید",  "AI-LiqScan BUY")
alertcondition(shortSig,  "🔴 سیگنال فروش",  "AI-LiqScan SELL")
alertcondition(sweepUp,   "✖ شکار نقدینگی بالا", "BSL swept")
alertcondition(sweepDown, "✖ شکار نقدینگی پایین","SSL swept")

if longSig or shortSig
    alert((longSig ? "🟢 BUY " : "🔴 SELL ") + syminfo.ticker + " | " + timeframe.period +
         "\nکیفیت: " + gradeS + " (" + pType + ")" +
         "\nقیمت: "   + str.tostring(close, format.mintick) +
         "\nاطمینان: " + str.tostring(conf, "#") + "% | R:R 1:" + str.tostring(tp2RR, "#.#") +
         "\nSL: "  + str.tostring(pSL,  format.mintick) +
         " | TP1: " + str.tostring(pTP1, format.mintick) +
         " | TP2: " + str.tostring(pTP2, format.mintick) +
         "\n— " + sigText, alert.freq_once_per_bar_close)

// هشدار اسکنر
scanMsg(string s, float cf, float fr) =>
    fr != 0 and cf >= minConf ? (fr > 0 ? "🟢 " : "🔴 ") + shortSym(s) + " " + str.tostring(cf, "#") + "%\n" : ""

msgAll = scanMsg(sym1, k1, r1) + scanMsg(sym2, k2, r2) + scanMsg(sym3, k3, r3) + scanMsg(sym4, k4, r4) +
         scanMsg(sym5, k5, r5) + scanMsg(sym6, k6, r6) + scanMsg(sym7, k7, r7) + scanMsg(sym8, k8, r8) +
         scanMsg(sym9, k9, r9) + scanMsg(sym10, k10, r10) + scanMsg(sym11, k11, r11) + scanMsg(sym12, k12, r12) +
         scanMsg(sym13, k13, r13) + scanMsg(sym14, k14, r14) + scanMsg(sym15, k15, r15)

if showScan and str.length(msgAll) > 0 and barstate.isconfirmed
    alert("🔎 فرصت جدید در اسکنر (" + scTF + "):\n" + msgAll + "— " + sigText, alert.freq_once_per_bar_close)
